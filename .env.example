APP_NAME=RDAPLook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── No database — RDAPLook is stateless ──────────────────────────────────────
# DB_CONNECTION defaults to sqlite in config/database.php when unset.
# Nothing in the application queries the database.

# ── Sessions + Cache + Queue ──────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=redis
CACHE_PREFIX=rdaplook_
QUEUE_CONNECTION=redis

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=0

# ── RapidAPI ──────────────────────────────────────────────────────────────────
# Middleware bypasses when this is empty (safe for local dev)
RAPIDAPI_PROXY_SECRET=

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@rdaplook.com"
MAIL_FROM_NAME="${APP_NAME}"
