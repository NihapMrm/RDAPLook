APP_NAME=RDAPLook
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://rdaplook.com
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Redis (DB index 2 — reserved for RDAPLook) ───────────────────────────────
# REDIS_HOST uses the Docker Compose service name — resolved inside rdaplook-network
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=2
REDIS_CACHE_DB=2

# ── Cache + Sessions ──────────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=rdaplook_
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis

# ── Trusted proxies ───────────────────────────────────────────────────────────
# Trust all proxies — safe because traffic arrives via Cloudflare → host nginx → Docker nginx.
# Allows Laravel to read X-Forwarded-Proto correctly and generate HTTPS URLs.
TRUSTED_PROXIES=*

# ── RapidAPI ──────────────────────────────────────────────────────────────────
# Get this from: RapidAPI dashboard → My APIs → rdaplook → Security
RAPIDAPI_PROXY_SECRET=CHANGE_THIS

# ── Mail (log only — no transactional mail needed) ───────────────────────────
MAIL_MAILER=log
