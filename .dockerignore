.git
.github
.idea
.vscode
node_modules
npm-debug.log*

# Built locally — rebuilt inside Docker via the frontend stage
public/build
public/hot

# Storage subdirs that are runtime-only (named volume takes over at runtime)
storage/framework/cache/data
storage/framework/sessions
storage/framework/views
storage/logs

# Bootstrap cache is regenerated by artisan post-deploy
bootstrap/cache/*.php

# Never bake secrets into the image
.env
.env.local
.env.production
.env.staging
.env.testing
*.key

# Test infrastructure not needed in the image
tests
phpunit.xml

# Docs and local-only scripts
README*.md
server-setup.sh
deploy.sh

# Docker config itself
docker-compose.yml
docker-compose.override.yml
.dockerignore

# Deployment artefacts handled outside Docker
deploy
