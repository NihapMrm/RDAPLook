        {
          "name": "Rate limit headers on success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All three rate-limit headers are present', () => {",
                  "    const limit     = pm.response.headers.get('X-RateLimit-Limit');",
                  "    const remaining = pm.response.headers.get('X-RateLimit-Remaining');",
                  "    const reset     = pm.response.headers.get('X-RateLimit-Reset');",
                  "    pm.expect(limit).to.exist;",
                  "    pm.expect(remaining).to.exist;",
                  "    pm.expect(reset).to.exist;",
                  "});",
                  "pm.test('Remaining <= Limit', () => {",
                  "    const limit     = parseInt(pm.response.headers.get('X-RateLimit-Limit'));",
                  "    const remaining = parseInt(pm.response.headers.get('X-RateLimit-Remaining'));",
                  "    pm.expect(remaining).to.be.at.most(limit);",
                  "});",
                  "pm.test('Reset is a future Unix timestamp', () => {",
                  "    const reset = parseInt(pm.response.headers.get('X-RateLimit-Reset'));",
                  "    pm.expect(reset).to.be.above(Date.now() / 1000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/availability/example.com",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "availability", "example.com"]
            },
            "description": "Verifies all three X-RateLimit-* headers are present and internally consistent."
