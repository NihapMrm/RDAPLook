          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/domain/not_a_valid_domain",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "domain", "not_a_valid_domain"]
