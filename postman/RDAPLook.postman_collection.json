      ]
    },
    {
      "name": "DNS Records",
      "description": "PHP `dns_get_record()` based resolution. Returns A, AAAA, MX, NS, TXT, CNAME, SOA records.",
      "item": [
        {
          "name": "Resolve – github.com (all types)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has domain field', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.domain).to.be.a('string');",
                  "});",
                  "pm.test('Records object has all 7 type keys', () => {",
                  "    const j = pm.response.json();",
                  "    ['A','AAAA','MX','NS','TXT','CNAME','SOA'].forEach(t => {",
                  "        pm.expect(j.records).to.have.property(t);",
                  "        pm.expect(j.records[t]).to.be.an('array');",
                  "    });",
                  "});",
                  "pm.test('A records have ip and ttl', () => {",
                  "    const a = pm.response.json().records.A;",
                  "    if (a.length > 0) {",
                  "        pm.expect(a[0]).to.have.property('ip');",
                  "        pm.expect(a[0]).to.have.property('ttl');",
                  "    }",
                  "});",
                  "pm.test('MX records have priority', () => {",
                  "    const mx = pm.response.json().records.MX;",
                  "    if (mx.length > 0) {",
                  "        pm.expect(mx[0]).to.have.property('priority');",
                  "        pm.expect(mx[0]).to.have.property('target');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/dns/{{test_domain}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "dns", "{{test_domain}}"]
            },
            "description": "Resolves all DNS record types for the domain."
          },
          "response": []
        },
