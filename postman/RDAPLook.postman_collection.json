{
  "info": {
    "name": "RDAPLook API",
    "description": "Domain intelligence API powered by RDAP and DNS lookups.\n\n**Authentication:** Pass your API key in the `X-API-Key` header.\n\n**Rate limit headers** are returned on every authenticated response:\n- `X-RateLimit-Limit` – daily cap for your plan\n- `X-RateLimit-Remaining` – requests left today\n- `X-RateLimit-Reset` – Unix timestamp when the counter resets (midnight UTC)\n\n**Standard error shape:**\n```json\n{ \"error\": true, \"code\": \"ERROR_CODE\", \"message\": \"Human readable message\" }\n```",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "rdaplook-v1-collection"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key",   "value": "X-API-Key",       "type": "string" },
      { "key": "value", "value": "{{api_key}}",      "type": "string" },
      { "key": "in",    "value": "header",           "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "{{base_url}}" }
  ],
  "item": [
    {
      "name": "Domain RDAP",
      "description": "RDAP-based domain registration lookups. Results are cached in Redis for 24 h.",
      "item": [
        {
          "name": "Lookup – github.com",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has domain field', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.domain).to.be.a('string');",
                  "});",
                  "pm.test('Has registrar object', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.registrar).to.be.an('object');",
                  "    pm.expect(j.registrar.name).to.be.a('string');",
                  "});",
                  "pm.test('Has dates object', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.dates).to.include.keys(['registered', 'updated', 'expires']);",
                  "});",
                  "pm.test('Has nameservers array', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.nameservers).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('Has status array', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.status).to.be.an('array');",
                  "});",
                  "pm.test('dnssec is boolean', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.dnssec).to.be.a('boolean');",
                  "});",
                  "pm.test('Has contacts object', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.contacts).to.include.keys(['registrant', 'admin', 'tech']);",
                  "});",
                  "pm.test('No raw_rdap by default', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j).to.not.have.property('raw_rdap');",
                  "});",
                  "pm.test('Rate limit headers present', () => {",
                  "    pm.expect(pm.response.headers.get('X-RateLimit-Limit')).to.exist;",
                  "    pm.expect(pm.response.headers.get('X-RateLimit-Remaining')).to.exist;",
                  "    pm.expect(pm.response.headers.get('X-RateLimit-Reset')).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/domain/{{test_domain}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "domain", "{{test_domain}}"]
            },
            "description": "Full RDAP lookup for a registered domain. Returns normalised registrar, dates, nameservers, status, DNSSEC, and contacts."
          },
          "response": []
        },
        {
          "name": "Lookup with raw=true",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('raw_rdap field present when ?raw=true', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j).to.have.property('raw_rdap');",
                  "    pm.expect(j.raw_rdap).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/domain/{{test_domain}}?raw=true",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "domain", "{{test_domain}}"],
              "query": [{ "key": "raw", "value": "true" }]
            },
            "description": "Same as the standard lookup but includes the original unmodified RDAP response under `raw_rdap`."
          },
          "response": []
        },
        {
